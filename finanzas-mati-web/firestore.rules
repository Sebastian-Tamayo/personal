rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios autenticados pueden leer y escribir.
    // Adecuado para un hogar pequeño (Sebas + Lore) en plan Spark.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
