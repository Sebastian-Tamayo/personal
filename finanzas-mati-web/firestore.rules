rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios autenticados pueden leer y escribir.
    // Adecuado para un hogar pequeño (Sebas + Lore + Hellen) en plan Spark.
    // Covers familia_items, familia_routines, familia_push_subs, familia_users, etc.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
