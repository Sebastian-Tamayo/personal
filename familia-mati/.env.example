# Same Firebase project as Finanzas Mati
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Link to sibling app (GH Pages)
VITE_FINANZAS_URL=https://sebastian-tamayo.github.io/personal/

# Optional family gate PIN (default used if unset). Client-side only.
# VITE_FINANZAS_PIN=

# Web Push (public VAPID only — never put the private key here)
VITE_VAPID_PUBLIC_KEY=
